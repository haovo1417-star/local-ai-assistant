# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Databases & local user data (CRITICAL: Do not commit local SQLite databases)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backups/

# Local configuration & environment variables
.env
.env.local
.env.*

# Snapshot backups during upgrades
*_before_*.py
app_backup.py
local_ai_backup_*.db

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Packaging & Distribution
build/
dist/
*.spec
